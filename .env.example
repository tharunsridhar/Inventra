# Copy this file to .env and fill in real values. Never commit .env itself.

# --- database ---
# Also used directly by docker-compose.yml to configure the postgres service
# itself (POSTGRES_USER/PASSWORD/DB) - keep these three in sync with whatever
# credentials appear in DATABASE_URL below.
POSTGRES_USER=inventra
POSTGRES_PASSWORD=inventra
POSTGRES_DB=inventra

# Must use the psycopg v3 driver ("+psycopg"), not the old psycopg2 one.
# Running the app directly on the host (uv run uvicorn ...), against Postgres
# on localhost:
DATABASE_URL=postgresql+psycopg://inventra:inventra@localhost:5432/inventra
# Running via `docker compose up` instead: the api container reaches Postgres
# over the compose network by service name, not localhost. docker-compose.yml
# already overrides DATABASE_URL to the line below for the api service, so you
# don't need to change anything here - it's just documented for reference:
#   DATABASE_URL=postgresql+psycopg://inventra:inventra@postgres:5432/inventra
# SQLAlchemy connection pool. Defaults shown - safe for a single app instance;
# raise DB_POOL_SIZE/DB_MAX_OVERFLOW if you run multiple replicas or see
# "QueuePool limit exceeded" errors under load.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- auth ---
# Required, no default - generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- cors / deployment ---
# JSON array of allowed origins. "*" is fine for local dev only - set this to
# your real frontend origin(s) in production (see README deployment section).
CORS_ALLOW_ORIGINS=["*"]
# JSON array of hostnames this app will answer for (Starlette TrustedHostMiddleware).
# "*" (any host) is fine for local dev - set this to your real Railway/custom
# domain in production, e.g. ["inventra-production.up.railway.app"]
ALLOWED_HOSTS=["*"]
# development | production - flip to production when deploying (see app/main.py)
ENVIRONMENT=development
