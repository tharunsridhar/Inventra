# Copy this file to .env and fill in real values. Never commit .env itself.

DJANGO_SETTINGS_MODULE=config.settings.development
# Required, no default - generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Must use the psycopg v3 driver ("+psycopg" — actually Django's postgresql
# backend picks psycopg v3 up automatically, no URL scheme change needed).
# Local dev (matches docker-compose.yml's postgres service):
DATABASE_URL=postgresql://inventra:inventra@localhost:5432/inventra_django
POSTGRES_USER=inventra
POSTGRES_PASSWORD=inventra
POSTGRES_DB=inventra_django
DB_CONN_MAX_AGE=600

# db 0 = cache, db 1 = Celery broker, db 2 = Celery result backend - local
# dev / docker-compose default is db 0 for the plain REDIS_URL used by the
# cache; CELERY_BROKER_URL/CELERY_RESULT_BACKEND default to db 1 / db 2 of
# this same REDIS_URL automatically (config/settings/base.py) - only set
# them here to override that derived default.
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- production only (config/settings/production.py) ---
ALLOWED_HOSTS=your-app.up.railway.app
CORS_ALLOWED_ORIGINS=https://your-app.up.railway.app
SECURE_SSL_REDIRECT=true
